{
  "name": "timeline-tasks",
  "version": "1.3.0",
  "description": "React timeline component for project tasks: task bars, due dates, overdue/delay overlays, grouping, filters and status colors.",
  "license": "MIT",
  "author": "leosole",
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leosole/timeline-tasks.git"
  },
  "homepage": "https://github.com/leosole/timeline-tasks#readme",
  "bugs": {
    "url": "https://github.com/leosole/timeline-tasks/issues"
  },
  "keywords": [
    "react",
    "timeline",
    "gantt",
    "tasks",
    "project-management",
    "component",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/task-timeline.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "dev:build": "tsup --watch --onSuccess \"node scripts/add-use-client.mjs\"",
    "build": "pnpm run build:js && pnpm run build:css",
    "build:demo": "vite build",
    "build:pages": "vite build --base=/timeline-tasks/",
    "build:js": "tsup && node scripts/add-use-client.mjs",
    "build:css": "tailwindcss -i src/styles.css -o dist/task-timeline.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.3",
    "@ui-sdk/react": "0.1.0-beta.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
